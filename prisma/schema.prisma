generator client {
  provider = "prisma-client-js"
}

generator kysely {
  provider = "prisma-kysely"
  output   = "../src/db/generated"
}

datasource db {
  provider = "postgresql"
}

model DeploymentSmokeCheck {
  id        String   @id @default(cuid())
  label     String   @default("phase-1")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("deployment_smoke_checks")
}
